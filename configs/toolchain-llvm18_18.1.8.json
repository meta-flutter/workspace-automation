{
  "id": "toolchain-llvm18",
  "description": "LLVM 18 toolchain for Flutter development.",
  "load": false,
  "supported_archs": [
    "aarch64",
    "arm64",
    "x86_64"
  ],
  "supported_host_types": [
    "darwin",
    "fedora",
    "ubuntu"
  ],
  "type": "toolchain",
  "toolchain": "llvm",
  "env": {
    "LLVM_VERSION": "18.1.8",
    "LLVM_BASE_DIR": "${FLUTTER_WORKSPACE}/.tmp/toolchain-llvm-${LLVM_VERSION}",
    "LLVM_BINDIR": "${LLVM_BASE_DIR}/bin",
    "LLVM_LIBDIR": "${LLVM_BASE_DIR}/lib",
    "LLVM_CONFIG": "${LLVM_BINDIR}/llvm-config",
    "PATH": "${LLVM_BINDIR}:$PATH",
    "CXXFLAGS": "-stdlib=libc++ -lc++abi",
    "LD_LIBRARY_PATH": "${LLVM_LIBDIR}:$LD_LIBRARY_PATH"
  },
  "append_to_runtime_env": {
      "common": [
        "# toolchain-llvm",
        "export PREFER_LLVM=${PREFER_LLVM}",
        "export LLVM_BASE_DIR=${LLVM_BASE_DIR}",
        "export LLVM_BINDIR=$LLVM_BASE_DIR/bin",
        "export LLVM_LIBDIR=$LLVM_BASE_DIR/lib",
        "export LLVM_CONFIG=$LLVM_BINDIR/llvm-config",
        "export PATH=$LLVM_BINDIR:$PATH",
        "export CXXFLAGS='-stdlib=libc++ -lc++abi'",
        "export OS_LIBPATH=\"$(uname -m)-$( [ \\\"$(uname -s)\\\" = \\\"Darwin\\\" ] && echo 'apple-darwin' || echo 'unknown-linux-gnu' )\"",
        "export LD_LIBRARY_PATH=$LLVM_LIBDIR:$LLVM_LIBDIR/$OS_LIBPATH:$LD_LIBRARY_PATH"
      ]
  },
  "runtime": {
    "artifacts": {
      "http": {
        "url": "https://github.com/llvm/llvm-project",
        "artifacts": {
          "aarch64": {
            "ubuntu": [
              {
                "os_release": ["22.04", "24.04"],
                "filename": "clang+llvm-${LLVM_VERSION}-aarch64-linux-gnu.tar.xz",
                "endpoint": "/releases/download/llvmorg-${LLVM_VERSION}/clang+llvm-${LLVM_VERSION}-aarch64-linux-gnu.tar.xz",

                "post_cmds": [
                  {
                    "cwd": "${LLVM_BASE_DIR}",
                    "shell": true,
                    "cmds": [
                      "sudo-apt-workspace install -yq lsb-release wget software-properties-common gnupg apt-file build-essential libtool",
                      "if [ $(lsb_release -rs) = \"22.04\" ]; then sudo-apt-workspace install -yq libtinfo5; fi",
                      "sudo-apt-workspace remove libunwind-* -yq || true",
                      "mkdir -p ${LLVM_BASE_DIR}",
                      "tar -xf \"${ARTIFACTS_DIR}/clang+llvm-${LLVM_VERSION}-aarch64-linux-gnu.tar.xz\" --strip-components=1",
                      "${LLVM_BINDIR}/llvm-ar qsL ${LLVM_BASE_DIR}/lib/aarch64-unknown-linux-gnu/libc++.a ${LLVM_BASE_DIR}/lib/aarch64-unknown-linux-gnu/libc++abi.a"
                    ]
                  }
                ]
              }
            ],
            "fedora": [
              {
                "filename": "clang+llvm-${LLVM_VERSION}-aarch64-linux-gnu.tar.xz",
                "endpoint": "/releases/download/llvmorg-${LLVM_VERSION}/clang+llvm-${LLVM_VERSION}-aarch64-linux-gnu.tar.xz",
                "post_cmds": [
                  {
                    "cwd": "${LLVM_BASE_DIR}",
                    "shell": true,
                    "cmds": [
                      "sudo-dnf-workspace install ncurses-compat-libs -yq",
                      "mkdir -p ${LLVM_BASE_DIR}",
                      "tar -xf \"${ARTIFACTS_DIR}/clang+llvm-${LLVM_VERSION}-aarch64-linux-gnu.tar.xz\" --strip-components=1",
                      "${LLVM_BINDIR}/llvm-ar qsL ${LLVM_BASE_DIR}/lib/aarch64-unknown-linux-gnu/libc++.a ${LLVM_BASE_DIR}/lib/aarch64-unknown-linux-gnu/libc++abi.a",
                      "sudo-dnf-workspace -y update", 
                      "sudo-dnf-workspace install -y libstdc++ libstdc++-devel libstdc++-static"
                    ]
                  }
                ]
              }
            ]
          },
          "arm64": {
            "darwin": [
              {
                "filename": "clang+llvm-${LLVM_VERSION}-arm64-apple-macos11.tar.xz",
                "endpoint": "/releases/download/llvmorg-${LLVM_VERSION}/clang+llvm-${LLVM_VERSION}-arm64-apple-macos11.tar.xz",
                "post_cmds": [
                  {
                    "cwd": "${LLVM_BASE_DIR}",
                    "shell": true,
                    "cmds": [
                      "mkdir -p ${LLVM_BASE_DIR}",
                      "tar -xf \"${ARTIFACTS_DIR}/clang+llvm-${LLVM_VERSION}-arm64-apple-macos11.tar.xz\" --strip-components=1"
                    ]
                  }
                ]
              }
            ]
          },
          "x86_64": {
            "ubuntu": [
              {
                "os_release": ["22.04", "24.04"],
                "filename": "clang+llvm-${LLVM_VERSION}-x86_64-linux-gnu-ubuntu-18.04.tar.xz",
                "endpoint": "/releases/download/llvmorg-${LLVM_VERSION}/clang+llvm-${LLVM_VERSION}-x86_64-linux-gnu-ubuntu-18.04.tar.xz",
                "post_cmds": [
                  {
                    "cwd": "${LLVM_BASE_DIR}",
                    "shell": true,
                    "cmds": [
                      "sudo-apt-workspace install -yq lsb-release wget software-properties-common gnupg apt-file build-essential libtool",
                      "if [ $(lsb_release -rs) = \"22.04\" ]; then sudo-apt-workspace install -yq libtinfo5; fi",
                      "if [ $(lsb_release -rs) = \"24.04\" ]; then wget http://security.ubuntu.com/ubuntu/pool/universe/n/ncurses/libtinfo5_6.3-2ubuntu0.2_amd64.deb -O /tmp/libtinfo5_6.3-2ubuntu0.2_amd64.deb && sudo apt install /tmp/libtinfo5_6.3-2ubuntu0.2_amd64.deb; fi",
                      "sudo-apt-workspace remove libunwind-* -yq || true",
                      "mkdir -p ${LLVM_BASE_DIR}",
                      "tar -xf \"${ARTIFACTS_DIR}/clang+llvm-${LLVM_VERSION}-x86_64-linux-gnu-ubuntu-18.04.tar.xz\" --strip-components=1",
                      "${LLVM_BINDIR}/llvm-ar qsL ${LLVM_BASE_DIR}/lib/x86_64-unknown-linux-gnu/libc++.a ${LLVM_BASE_DIR}/lib/x86_64-unknown-linux-gnu/libc++abi.a"
                    ]
                  }
                ]
              }
            ],
            "fedora": [
              {
                "filename": "clang+llvm-${LLVM_VERSION}-x86_64-linux-gnu-ubuntu-18.04.tar.xz",
                "endpoint": "/releases/download/llvmorg-${LLVM_VERSION}/clang+llvm-${LLVM_VERSION}-x86_64-linux-gnu-ubuntu-18.04.tar.xz",
                "post_cmds": [
                  {
                    "cwd": "${LLVM_BASE_DIR}",
                    "shell": true,
                    "cmds": [
                      "sudo-dnf-workspace install ncurses-compat-libs -yq",
                      "mkdir -p ${LLVM_BASE_DIR}",
                      "tar -xf \"${ARTIFACTS_DIR}/clang+llvm-${LLVM_VERSION}-x86_64-linux-gnu-ubuntu-18.04.tar.xz\" --strip-components=1",
                      "${LLVM_BINDIR}/llvm-ar qsL ${LLVM_BASE_DIR}/lib/x86_64-unknown-linux-gnu/libc++.a ${LLVM_BASE_DIR}/lib/x86_64-unknown-linux-gnu/libc++abi.a",
                      "sudo-dnf-workspace -y update", 
                      "sudo-dnf-workspace install -y libstdc++ libstdc++-devel libstdc++-static"
                    ]
                  }
                ]
              }
            ]
          }
        }
      }
    },
    "pre-requisites": {
      "aarch64": {
        "ubuntu": {
          "shell": true,
          "20.04": {
            "cmds": [
              "sudo-apt-workspace install -yq lsb-release wget software-properties-common gnupg apt-file build-essential libtool",
              "wget https://apt.llvm.org/llvm.sh", 
              "chmod +x llvm.sh", 
              "sudo ./llvm.sh ${PREFER_LLVM} all", 
              "rm ./llvm.sh",
              "bash -c 'export MAJOR_VERSION=$(echo ${LLVM_VERSION} | cut -d. -f1); LLVM_INSTALL_DIR=$(/usr/bin/llvm-config-$MAJOR_VERSION --prefix) && sudo ln -s $LLVM_INSTALL_DIR ${LLVM_BASE_DIR}'"
            ]
          }
        }
      },
      "x86_64": {
        "ubuntu": {
          "20.04": {
            "shell": true,
            "cmds": [
              "sudo-apt-workspace install -yq lsb-release wget software-properties-common gnupg apt-file build-essential libtool",
              "wget https://apt.llvm.org/llvm.sh", 
              "chmod +x llvm.sh", 
              "sudo ./llvm.sh ${PREFER_LLVM} all", 
              "rm ./llvm.sh",
              "bash -c 'export MAJOR_VERSION=$(echo ${LLVM_VERSION} | cut -d. -f1); LLVM_INSTALL_DIR=$(/usr/bin/llvm-config-$MAJOR_VERSION --prefix) && sudo ln -s $LLVM_INSTALL_DIR ${LLVM_BASE_DIR}'"
            ]
          }
        },
        "darwin": {
          "shell": true,
          "cmds": [
            "brew install llvm@18"
          ]
        }
      }
    }
  }
}

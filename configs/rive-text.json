{
    "id": "rive-text",
    "load": true,
    "supported_archs": [
        "aarch64",
        "arm64",
        "x86_64"
    ],
    "supported_host_types": [
        "fedora",
        "ubuntu"
    ],
    "type": "dependency",
    "env": {
        "RIVE_TEXT_SRC_DIR": "${FLUTTER_WORKSPACE}/app/rive-common",
        "RIVE_TEXT_BUILD_DIR": "${RIVE_TEXT_SRC_DIR}/build",
        "RIVE_TEXT_CMAKE_ARGS": "-DCMAKE_BUILD_TYPE=${CMAKE_BUILD_TYPE}"
    },
    "src": [
        {
            "uri": "https://github.com/meta-flutter/rive-common.git",
            "branch": "main"
        },
        {
            "uri": "https://github.com/rive-app/rive-flutter.git",
            "branch": "master",
            "rev": "0.8.4"
        }
    ],
    "runtime": {
        "post_cmds": [
            {
                "env": {
                    "$PATH": "${FLUTTER_WORKSPACE}/.config/flutter_workspace/toolchain-common-ninja:${FLUTTER_WORKSPACE}/.config/flutter_workspace/toolchain-common-cmake/cmake-3.31.0/bin:$PATH"
                },
                "cwd": "${RIVE_TEXT_BUILD_DIR}",
                "cmds": [
                    "rm -rf * | true",
                    "cmake --version",
                    "cmake -GNinja ${RIVE_TEXT_CMAKE_ARGS} -S${RIVE_TEXT_SRC_DIR} -B${RIVE_TEXT_BUILD_DIR}",
                    "ninja -j${HARDWARE_THREADS}"
                ]
            }
        ]
    }
}

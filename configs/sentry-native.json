{
    "id": "sentry-native",
    "load": false,
    "supported_archs": [
        "aarch64",
        "arm64",
        "x86_64"
    ],
    "supported_host_types": [
        "fedora",
        "ubuntu"
    ],
    "type": "dependency",
    "env": {
        "PATH": "${PATH}:${FLUTTER_WORKSPACE}/app/depot_tools",
        "CMAKE_BUILD_TYPE": "MinSizeRel",
        "SENTRY_NATIVE_SRC_DIR": "${FLUTTER_WORKSPACE}/app/sentry-native",
        "SENTRY_NATIVE_BUILD_DIR": "${FLUTTER_WORKSPACE}/app/sentry-native/cmake-build-debug",
        "SENTRY_NATIVE_STAGING_DIR": "${SENTRY_NATIVE_BUILD_DIR}/staging/debug",
        "SENTRY_NATIVE_CMAKE_ARGS": "-GNinja -D SENTRY_BUILD_TESTS=OFF -D SENTRY_BUILD_EXAMPLES=OFF -D SENTRY_BUILD_FORCE32=OFF -DCMAKE_STAGING_PREFIX=${SENTRY_NATIVE_STAGING_DIR} -DCMAKE_BUILD_TYPE=${CMAKE_BUILD_TYPE}"
    },
    "src": [
        {
            "uri": "https://github.com/getsentry/sentry-native.git",
            "branch": "master"
        }
    ],
    "runtime": {
        "pre-requisites": {
            "x86_64": {
                "fedora": {
                    "cmds": [
                        "sudo dnf install libunwind-devel"
                    ]
                },
                "ubuntu": {
                    "cmds": [
                        "sudo apt-get install libunwind-dev"
                    ]
                }
            }
        },
        "post_cmds": [
            {
                "cwd": "${SENTRY_NATIVE_BUILD_DIR}",
                "cmds": [
                    "cmake ${SENTRY_NATIVE_SRC_DIR} ${SENTRY_NATIVE_CMAKE_ARGS}",
                    "autoninja"
                ]
            }
        ]
    }
}
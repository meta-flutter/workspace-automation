{
    "id": "sentry-native",
    "load": false,
    "supported_archs": [
        "aarch64",
        "arm64",
        "x86_64"
    ],
    "supported_host_types": [
        "fedora",
        "ubuntu"
    ],
    "type": "dependency",
    "env": {
        "PATH": "${FLUTTER_WORKSPACE}/.config/flutter_workspace/toolchain-common-ninja:${FLUTTER_WORKSPACE}/.config/flutter_workspace/toolchain-common-cmake/cmake-3.31.0/bin:$PATH",
        "LD_LIBRARY_PATH": "${FLUTTER_WORKSPACE}/.config/flutter_workspace/toolchain-common-cmake/cmake-3.31.0/lib",
        "SENTRY_NATIVE_SRC_DIR": "${FLUTTER_WORKSPACE}/app/sentry-native",
        "SENTRY_NATIVE_BUILD_DIR": "${FLUTTER_WORKSPACE}/app/sentry-native/build",
        "SENTRY_NATIVE_STAGING_DIR": "${SENTRY_NATIVE_BUILD_DIR}/staging/debug",
        "SENTRY_NATIVE_CMAKE_ARGS": "-DSENTRY_BUILD_TESTS=OFF -DSENTRY_BUILD_EXAMPLES=OFF -DSENTRY_BUILD_FORCE32=OFF -DCMAKE_STAGING_PREFIX=${SENTRY_NATIVE_STAGING_DIR} -DCMAKE_BUILD_TYPE=${CMAKE_BUILD_TYPE}"
    },
    "src": [
        {
            "uri": "https://github.com/getsentry/sentry-native.git",
            "branch": "master"
        }
    ],
    "runtime": {
        "post_cmds": [
            {
                "cwd": "${SENTRY_NATIVE_BUILD_DIR}",
                "cmds": [
                    "bash -c \"rm -rf CMakeCache.txt CMakeFiles | true\"",
                    "cmake -G Ninja ${SENTRY_NATIVE_CMAKE_ARGS} -S ${SENTRY_NATIVE_SRC_DIR} -B ${SENTRY_NATIVE_BUILD_DIR}",
                    "ninja -j${HARDWARE_THREADS}",
                    "${LLVM_STRIP} ${SENTRY_NATIVE_BUILD_DIR}/libsentry.so"
                ]
            }
        ],
        "do_clean": [
            {
                "cwd": "${SENTRY_NATIVE_BUILD_DIR}",
                "cmds": [
                    "ninja -t clean"
                ]
            }
        ]
    }
}
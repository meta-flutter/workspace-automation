{
  "id": "clang-stable",
  "load": true,
  "supported_archs": [
    "aarch64",
    "x86_64"
  ],
  "supported_host_types": [
    "ubuntu",
    "fedora"
  ],
  "type": "toolchain",
  "toolchain": "clang",
  "runtime": {
    "pre-requisites": {
      "aarch64": {
        "ubuntu": {
          "cmds": [
            "sudo apt update -y",
            "sudo apt install -y lsb-release wget software-properties-common gnupg apt-file",
            "sudo add-apt-repository -y ppa:kisak/kisak-mesa",
            "sudo apt update -y",
            "sudo apt upgrade -y",
            "sudo apt install -y libxkbcommon-dev libwayland-dev wayland-protocols mesa-common-dev libegl1-mesa-dev libgles2-mesa-dev mesa-utils libsecret-1-dev libsdl2-dev libjpeg-dev zenity",
            "sudo apt install -y build-essential libtool"
          ],
          "20.04": [
            "echo \"Ubuntu 20.04 - aarch64\"",
            "sudo snap install cmake --classic",
            "wget https://apt.llvm.org/llvm.sh",
            "chmod +x llvm.sh",
            "sudo ./llvm.sh all",
            "rm ./llvm.sh"
          ],
          "22.04": [
            "echo \"Ubuntu 22.04 - aarch64\"",
            "sudo snap install cmake --classic",
            "wget https://apt.llvm.org/llvm.sh",
            "chmod +x llvm.sh",
            "sudo ./llvm.sh all",
            "rm ./llvm.sh"
          ],
          "24.04": [
            "echo \"Ubuntu 24.04 - aarch64\"",
            "sudo apt install -y cmake",
            "wget https://apt.llvm.org/llvm.sh",
            "chmod +x llvm.sh",
            "sudo ./llvm.sh all",
            "rm ./llvm.sh"
          ]
        }
      },
      "x86_64": {
        "ubuntu": {
          "cmds": [
            "sudo apt update -y",
            "sudo apt install -y lsb-release wget software-properties-common gnupg apt-file",
            "sudo add-apt-repository -y ppa:kisak/kisak-mesa",
            "sudo apt update -y",
            "sudo apt upgrade -y",
            "sudo apt install -y libxkbcommon-dev libwayland-dev wayland-protocols mesa-common-dev libegl1-mesa-dev libgles2-mesa-dev mesa-utils libsecret-1-dev libsdl2-dev libjpeg-dev zenity",
            "sudo apt install -y build-essential libtool"
          ],
          "20.04": [
            "echo \"Ubuntu 20.04 - x86_64\"",
            "sudo snap install cmake --classic",
            "wget https://apt.llvm.org/llvm.sh",
            "chmod +x llvm.sh",
            "sudo ./llvm.sh all",
            "rm ./llvm.sh"
          ],
          "22.04": [
            "echo \"Ubuntu 22.04 - x86_64\"",
            "sudo snap install cmake --classic",
            "wget https://apt.llvm.org/llvm.sh",
            "chmod +x llvm.sh",
            "sudo ./llvm.sh all",
            "rm ./llvm.sh"
          ],
          "24.04": [
            "echo \"Ubuntu 24.04 - x86_64\"",
            "sudo apt install -y cmake",
            "wget https://apt.llvm.org/llvm.sh",
            "chmod +x llvm.sh",
            "sudo ./llvm.sh all",
            "rm ./llvm.sh"
          ]
        },
        "fedora": {
          "cmds": [
            "sudo dnf -y update",
            "sudo dnf -y upgrade",
            "sudo dnf -y install cmake lld libtool",
            "sudo dnf -y install llvm-devel clang clang-format clangd clang-tidy lldb lld libcxx-devel libcxx-static libcxxabi-devel libcxxabi-static",
            "sudo dnf -y install wayland-devel wayland-protocols-devel libxkbcommon-devel mesa-dri-drivers mesa-filesystem mesa-libEGL-devel mesa-libGL-devel mesa-libGLU-devel mesa-libgbm-devel mesa-libglapi mesa-libxatracker",
            "cmake --version"
          ]
        }
      }
    }
  }
}

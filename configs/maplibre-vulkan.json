{
    "id": "maplibre-vulkan",
    "load": false,
    "supported_archs": [
        "aarch64",
        "arm64",
        "x86_64"
    ],
    "supported_host_types": [
        "ubuntu",
        "fedora"
    ],
    "type": "dependency",
    "env": {
        "PATH": "${FLUTTER_WORKSPACE}/.config/flutter_workspace/toolchain-common-ninja:${FLUTTER_WORKSPACE}/.config/flutter_workspace/toolchain-common-cmake/cmake-3.31.0/bin:$PATH",
        "LD_LIBRARY_PATH": "${FLUTTER_WORKSPACE}/.config/flutter_workspace/toolchain-common-cmake/cmake-3.31.0/lib",
        "MAPLIBRE_SRC_DIR": "${FLUTTER_WORKSPACE}/app/maplibre-native",
        "MAPLIBRE_BUILD_DIR": "${FLUTTER_WORKSPACE}/app/maplibre-native/build",
        "MAPLIBRE_CMAKE_ARGS": "-DBUILD_SHARED_LIBS=OFF -DMLN_WITH_WERROR=OFF -DMLN_WITH_VULKAN=ON -DMLN_DRAWABLE_RENDERER=ON -DMLN_LEGACY_RENDERER=OFF -DMLN_WITH_EGL=OFF -DMLN_WITH_OPENGL=OFF",
        "PATCH_FOLDER": "${FLUTTER_WORKSPACE}/patches/maplibre-vulkan"
    },
    "src": [
        {
            "uri": "https://github.com/maplibre/maplibre-native.git",
            "branch": "main"
        }
    ],
    "runtime": {
        "pre-requisites": {
            "aarch64": {
                "ubuntu": {
                    "cmds": [
                        "sudo apt install -y libwebp-dev libuv1-dev libcurl4-openssl-dev libjpeg-dev libpng-dev libicu-dev libglfw3-dev"
                    ]
                }
            },
            "x86_64": {
                "ubuntu": {
                    "cmds": [
                        "sudo apt install -y libwebp-dev libuv1-dev libcurl4-openssl-dev libjpeg-dev libpng-dev libicu-dev libglfw3-dev"
                    ]
                },
                "fedora": {
                    "cmds": [
                        "sudo dnf install -y libwebp-devel libuv-devel libcurl-devel libjpeg-devel libpng-devel libicu-devel glfw-devel"
                    ]
                }
            }
        },
        "post_cmds": [
            {
                "cwd": "${MAPLIBRE_SRC_DIR}",
                "cmds": [
                    "git apply ${PATCH_FOLDER}/0001-platform-linux-wayland-vulkan.patch"
                ]
            },
            {
                "cwd": "${MAPLIBRE_BUILD_DIR}",
                "cmds": [
                    "bash -c \"rm -rf CMakeCache.txt CMakeFiles | true\"",
                    "cmake -G Ninja ${MAPLIBRE_CMAKE_ARGS} -S ${MAPLIBRE_SRC_DIR} -B ${MAPLIBRE_BUILD_DIR}",
                    "ninja -j${HARDWARE_THREADS}"
                ]
            }
        ]
    }
}
{
  "id": "toolchain-llvm",
  "description": "LLVM toolchain for Flutter development. Version is configurable via PREFER_LLVM environment variable.",
  "load": true,
  "supported_archs": [
    "aarch64",
    "arm64",
    "x86_64"
  ],
  "supported_host_types": [
    "darwin",
    "fedora",
    "ubuntu"
  ],
  "type": "toolchain",
  "toolchain": "llvm",
  "env": {
    "DEFAULT_VERSION": "19",
    "LLVM_VERSION": "19.1.7",
    "LLVM_BASE_DIR": "${FLUTTER_WORKSPACE}/.config/flutter_workspace/toolchain-llvm-${LLVM_VERSION}",
    "LLVM_BINDIR": "${LLVM_BASE_DIR}/bin",
    "LLVM_LIBDIR": "${LLVM_BASE_DIR}/lib",
    "LLVM_CONFIG": "${LLVM_BINDIR}/llvm-config",
    "PATH": "${LLVM_BINDIR}:$PATH",
    "LD_LIBRARY_PATH": "${LLVM_LIBDIR}:$LD_LIBRARY_PATH"
  },
  "append_to_runtime_env": {
      "common": [
        "# toolchain-llvm",
        "export PREFER_LLVM=${PREFER_LLVM}",
        "export LLVM_BASE_DIR=${LLVM_BASE_DIR}",
        "export LLVM_BINDIR=$LLVM_BASE_DIR/bin",
        "export LLVM_LIBDIR=$LLVM_BASE_DIR/lib",
        "export LLVM_CONFIG=$LLVM_BINDIR/llvm-config",
        "export PATH=$LLVM_BINDIR:$PATH",
        "export LD_LIBRARY_PATH=$LLVM_LIBDIR:$LD_LIBRARY_PATH"
      ]
  },
  "runtime": {
    "artifacts": {
      "http": {
        "url": "https://github.com/llvm/llvm-project",
        "artifacts": {
          "aarch64": {
            "ubuntu": [
              {
                "filename": "clang+llvm-${LLVM_VERSION}-aarch64-linux-gnu.tar.xz",
                "endpoint": "/releases/download/llvmorg-${LLVM_VERSION}/clang+llvm-${LLVM_VERSION}-aarch64-linux-gnu.tar.xz",
                "post_cmds": [
                  {
                    "cwd": "${LLVM_BASE_DIR}",
                    "shell": true,
                    "cmds": [
                      "sudo apt-get install -yq lsb-release wget software-properties-common gnupg apt-file build-essential libtool",
                      "sudo add-apt-repository -y ppa:kisak/kisak-mesa", 
                      "sudo apt-get update -yq", 
                      "if [ \"$CI\" = \"true\" ]; then sudo apt-get upgrade -yq --fix-missing || sudo apt-get upgrade -yq -o Dpkg::Options::=\"--force-confdef\" -o Dpkg::Options::=\"--force-confold\" || echo 'Upgrade completed with some errors - continuing'; else sudo apt-get upgrade -yq; fi", 
                      "sudo apt-get install -yq libxkbcommon-dev libwayland-dev wayland-protocols mesa-common-dev libegl1-mesa-dev libgles2-mesa-dev mesa-utils libsecret-1-dev libsdl2-dev libjpeg-dev zenity", 
                      "sudo apt-get remove libunwind-* -yq || true",
                      "mkdir -p ${LLVM_BASE_DIR}",
                      "tar -xf \"${PLATFORM_ID_DIR}/artifacts/clang+llvm-${LLVM_VERSION}-aarch64-linux-gnu.tar.xz\" --strip-components=1",
                      "${LLVM_BINDIR}/llvm-ar qsL ${LLVM_BASE_DIR}/lib/aarch64-unknown-linux-gnu/libc++.a ${LLVM_BASE_DIR}/lib/aarch64-unknown-linux-gnu/libc++abi.a"
                    ]
                  }
                ]
              }
            ],
            "fedora": [
              {
                "filename": "clang+llvm-${LLVM_VERSION}-aarch64-linux-gnu.tar.xz",
                "endpoint": "/releases/download/llvmorg-${LLVM_VERSION}/clang+llvm-${LLVM_VERSION}-aarch64-linux-gnu.tar.xz",
                "post_cmds": [
                  {
                    "cwd": "${LLVM_BASE_DIR}",
                    "shell": true,
                    "cmds": [
                      "mkdir -p ${LLVM_BASE_DIR}",
                      "tar -xf \"${PLATFORM_ID_DIR}/artifacts/clang+llvm-${LLVM_VERSION}-aarch64-linux-gnu.tar.xz\" --strip-components=1",
                      "${LLVM_BINDIR}/llvm-ar qsL ${LLVM_BASE_DIR}/lib/aarch64-unknown-linux-gnu/libc++.a ${LLVM_BASE_DIR}/lib/aarch64-unknown-linux-gnu/libc++abi.a",
                      "sudo dnf -y update", 
                      "sudo dnf install -y libstdc++ libstdc++-devel libstdc++-static",
                      "if [ $(rpm -E %fedora) -le 42 ]; then sudo dnf -y install libxkbcommon-devel wayland-devel wayland-protocols-devel mesa-dri-drivers mesa-filesystem mesa-libEGL-devel mesa-libGL-devel mesa-libGLU-devel mesa-libgbm-devel mesa-libxatracker; fi", 
                      "if [ $(rpm -E %fedora) -ge 43 ]; then sudo dnf -y install libxkbcommon-devel wayland-devel wayland-protocols-devel mesa-dri-drivers mesa-filesystem mesa-libEGL-devel mesa-libGL-devel mesa-libGLU-devel mesa-libgbm-devel mesa-compat-libxatracker; fi"
                    ]
                  }
                ]
              }
            ]
          },
          "arm64": {
            "darwin": [
              {
                "filename": "LLVM-${LLVM_VERSION}-macOS-ARM64.tar.xz",
                "endpoint": "/releases/download/llvmorg-${LLVM_VERSION}/LLVM-${LLVM_VERSION}-macOS-ARM64.tar.xz",
                "post_cmds": [
                  {
                    "cwd": "${LLVM_BASE_DIR}",
                    "shell": true,
                    "cmds": [
                      "mkdir -p ${LLVM_BASE_DIR}",
                      "tar -xf \"${PLATFORM_ID_DIR}/artifacts/LLVM-${LLVM_VERSION}-macOS-ARM64.tar.xz\" --strip-components=1"
                    ]
                  }
                ]
              }
            ]
          },
          "x86_64": {
            "ubuntu": [
              {
                "filename": "LLVM-${LLVM_VERSION}-Linux-X64.tar.xz",
                "endpoint": "/releases/download/llvmorg-${LLVM_VERSION}/LLVM-${LLVM_VERSION}-Linux-X64.tar.xz",
                "sha256": "4a5ec53951a584ed36f80240f6fbf8fdd46b4cf6c7ee87cc2d5018dc37caf679",
                "post_cmds": [
                  {
                    "cwd": "${LLVM_BASE_DIR}",
                    "shell": true,
                    "cmds": [
                      "sudo apt-get install -yq lsb-release wget software-properties-common gnupg apt-file build-essential libtool",
                      "sudo add-apt-repository -y ppa:kisak/kisak-mesa", 
                      "sudo apt-get update -yq", 
                      "if [ \"$CI\" = \"true\" ]; then sudo apt-get upgrade -yq --fix-missing || sudo apt-get upgrade -yq -o Dpkg::Options::=\"--force-confdef\" -o Dpkg::Options::=\"--force-confold\" || echo 'Upgrade completed with some errors - continuing'; else sudo apt-get upgrade -yq; fi", 
                      "sudo apt-get install -yq libxkbcommon-dev libwayland-dev wayland-protocols mesa-common-dev libegl1-mesa-dev libgles2-mesa-dev mesa-utils libsecret-1-dev libsdl2-dev libjpeg-dev zenity", 
                      "sudo apt-get remove libunwind-* -yq || true",
                      "mkdir -p ${LLVM_BASE_DIR}",
                      "tar -xf \"${PLATFORM_ID_DIR}/artifacts/LLVM-${LLVM_VERSION}-Linux-X64.tar.xz\" --strip-components=1",
                      "${LLVM_BINDIR}/llvm-ar qsL ${LLVM_BASE_DIR}/lib/x86_64-unknown-linux-gnu/libc++.a ${LLVM_BASE_DIR}/lib/x86_64-unknown-linux-gnu/libc++abi.a"
                    ]
                  }
                ]
              }
            ],
            "fedora": [
              {
                "filename": "LLVM-${LLVM_VERSION}-Linux-X64.tar.xz",
                "endpoint": "/releases/download/llvmorg-${LLVM_VERSION}/LLVM-${LLVM_VERSION}-Linux-X64.tar.xz",
                "sha256": "4a5ec53951a584ed36f80240f6fbf8fdd46b4cf6c7ee87cc2d5018dc37caf679",
                "post_cmds": [
                  {
                    "cwd": "${LLVM_BASE_DIR}",
                    "shell": true,
                    "cmds": [
                      "mkdir -p ${LLVM_BASE_DIR}",
                      "tar -xf \"${PLATFORM_ID_DIR}/artifacts/LLVM-${LLVM_VERSION}-Linux-X64.tar.xz\" --strip-components=1",
                      "${LLVM_BINDIR}/llvm-ar qsL ${LLVM_BASE_DIR}/lib/x86_64-unknown-linux-gnu/libc++.a ${LLVM_BASE_DIR}/lib/x86_64-unknown-linux-gnu/libc++abi.a",
                      "sudo dnf -y update", 
                      "sudo dnf install -y libstdc++ libstdc++-devel libstdc++-static",
                      "if [ $(rpm -E %fedora) -le 42 ]; then sudo dnf -y install libxkbcommon-devel wayland-devel wayland-protocols-devel mesa-dri-drivers mesa-filesystem mesa-libEGL-devel mesa-libGL-devel mesa-libGLU-devel mesa-libgbm-devel mesa-libxatracker; fi", 
                      "if [ $(rpm -E %fedora) -ge 43 ]; then sudo dnf -y install libxkbcommon-devel wayland-devel wayland-protocols-devel mesa-dri-drivers mesa-filesystem mesa-libEGL-devel mesa-libGL-devel mesa-libGLU-devel mesa-libgbm-devel mesa-compat-libxatracker; fi"
                    ]
                  }
                ]
              }
            ],
            "darwin": [
              {
                "filename": "LLVM-${LLVM_VERSION}-macOS-X64.tar.xz",
                "endpoint": "/releases/download/llvmorg-${LLVM_VERSION}/LLVM-${LLVM_VERSION}-macOS-X64.tar.xz",
                "post_cmds": [
                  {
                    "cwd": "${LLVM_BASE_DIR}",
                    "shell": true,
                    "cmds": [
                      "mkdir -p ${LLVM_BASE_DIR}",
                      "tar -xf \"${PLATFORM_ID_DIR}/artifacts/LLVM-${LLVM_VERSION}-macOS-X64.tar.xz\" --strip-components=1"
                    ]
                  }
                ]
              }
            ]
          }
        }
      }
    }
  }
}

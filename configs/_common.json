{
  "id": "clang",
  "load": true,
  "supported_archs": [
    "aarch64",
    "arm64",
    "x86_64"
  ],
  "supported_host_types": [
    "ubuntu",
    "fedora"
  ],
  "type": "dependency",
  "runtime": {
    "pre-requisites": {
      "aarch64": {
        "ubuntu": {
          "cmds": [
            "sudo apt update -y",
            "sudo apt install -y lsb-release wget software-properties-common gnupg apt-file",
            "sudo add-apt-repository -y ppa:kisak/kisak-mesa",
            "sudo apt update -y",
            "sudo apt upgrade -y",
            "sudo apt install -y libxkbcommon-dev libwayland-dev wayland-protocols mesa-common-dev libegl1-mesa-dev libgles2-mesa-dev mesa-utils libsecret-1-dev libsdl2-dev libjpeg-dev zenity",
            "sudo apt install -y build-essential libtool ninja-build",
            "find /usr -name llvm-config*",
            "$(find /usr -name llvm-config*) --version",
            "$(find /usr -name llvm-config*) --prefix",
            "$(find /usr -name llvm-config*) --cmakedir",
            "sudo apt install -y flatpak libflatpak-dev gnome-software-plugin-flatpak",
            "sudo flatpak remote-add --if-not-exists flathub https://flathub.org/repo/flathub.flatpakrepo",
            "flatpak remotes"
          ],
          "20.04": [
            "echo \"Ubuntu 20.04\"",
            "sudo snap install cmake --classic",
            "sudo bash -c \"$(wget -O - https://apt.llvm.org/llvm.sh)\"",
            "pkg-config --modversion gstreamer-1.0 gstreamer-audio-1.0"
          ],
          "22.04": [
            "echo \"Ubuntu 22.04\"",
            "sudo snap install cmake --classic",
            "sudo bash -c \"$(wget -O - https://apt.llvm.org/llvm.sh)\"",
            "pkg-config --modversion gstreamer-1.0 gstreamer-audio-1.0"
          ],
          "24.04": [
            "echo \"Ubuntu 24.04\"",
            "sudo apt install cmake",
            "sudo bash -c \"$(wget -O - https://apt.llvm.org/llvm.sh)\"",
            "pkg-config --modversion gstreamer-1.0 gstreamer-audio-1.0"
          ]
        }
      },
      "x86_64": {
        "ubuntu": {
          "cmds": [
            "sudo apt update -y",
            "sudo apt install -y lsb-release wget software-properties-common gnupg apt-file",
            "sudo add-apt-repository -y ppa:kisak/kisak-mesa",
            "sudo apt update -y",
            "sudo apt upgrade -y",
            "sudo apt install -y libxkbcommon-dev libwayland-dev wayland-protocols mesa-common-dev libegl1-mesa-dev libgles2-mesa-dev mesa-utils libsecret-1-dev libsdl2-dev libjpeg-dev zenity",
            "sudo apt install -y build-essential libtool ninja-build",
            "find /usr -name llvm-config*",
            "$(find /usr -name llvm-config*) --version",
            "$(find /usr -name llvm-config*) --prefix",
            "$(find /usr -name llvm-config*) --cmakedir",
            "sudo apt install -y flatpak libflatpak-dev gnome-software-plugin-flatpak",
            "sudo flatpak remote-add --if-not-exists flathub https://flathub.org/repo/flathub.flatpakrepo",
            "flatpak remotes"
          ],
          "20.04": [
            "echo \"Ubuntu 20.04\"",
            "sudo snap install cmake --classic",
            "sudo bash -c \"$(wget -O - https://apt.llvm.org/llvm.sh)\""
          ],
          "22.04": [
            "echo \"Ubuntu 22.04\"",
            "sudo snap install cmake --classic",
            "sudo bash -c \"$(wget -O - https://apt.llvm.org/llvm.sh)\""
          ],
          "24.04": [
            "echo \"Ubuntu 24.04\"",
            "sudo apt install cmake",
            "sudo bash -c \"$(wget -O - https://apt.llvm.org/llvm.sh)\""
          ]
        }
      },
      "fedora": {
        "cmds": [
          "sudo dnf -y update",
          "sudo dnf -y upgrade",
          "sudo dnf -y install ninja-build cmake lld libtool",
          "sudo dnf -y install llvm-devel clang clang-format clangd clang-tidy lldb lld libcxx-devel libcxx-static libcxxabi-devel libcxxabi-static",
          "sudo dnf -y install wayland-devel wayland-protocols-devel libxkbcommon-devel cmake ninja-build mesa-dri-drivers mesa-filesystem mesa-libEGL-devel mesa-libGL-devel mesa-libGLU-devel mesa-libgbm-devel mesa-libglapi mesa-libxatracker",
          "cmake --version"
        ],
        "41": [
          "echo \"Fedora 41\""
        ]
      }
    }
  }
}
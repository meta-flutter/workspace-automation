{
  "id": "agl-ivi-demo-flutter-qemu",
  "load": false,
  "supported_archs": [
    "aarch64",
    "arm64",
    "x86_64"
  ],
  "supported_host_types": [
    "darwin",
    "fedora",
    "ubuntu"
  ],
  "type": "qemu",
  "env": {
    "RELEASE_NAME": "salmon",
    "RELEASE_VERSION": "latest",
    "FLUTTER_VERSION": "3.27.1",
    "FLUTTER_DEBUG_PORT": "1234",
    "FLUTTER_OBSERVATORY_HOST": "0.0.0.0",
    "CONTAINER_SSH_PORT": "2222",
    "DEVICE_HOSTNAME": "localhost",
    "COMPOSITOR_USER": "agl-driver",
    "SERVICE_NAME": "flutter-ics-homescreen",
    "SCP_PREFIX": "scp -P ${CONTAINER_SSH_PORT} -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null",
    "SSH_PREFIX": "ssh -p ${CONTAINER_SSH_PORT} -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o BatchMode=yes",
    "FLUTTER_AUTO_EXE": "flutter-auto -b /tmp/${appName}",
    "PING_CMD": "(echo >/dev/tcp/localhost/${CONTAINER_SSH_PORT}) &>/dev/null && echo open || echo closed",
    "DELETE_USER_PWD": "${SSH_PREFIX} -t root@${DEVICE_HOSTNAME} passwd -d ${COMPOSITOR_USER}",
    "STOP_SERVICE": "${SSH_PREFIX} -t root@${DEVICE_HOSTNAME} systemctl stop ${SERVICE_NAME}",
    "DELETE_APP_FOLDER": "${SSH_PREFIX} -t ${COMPOSITOR_USER}@${DEVICE_HOSTNAME} rm -rf /tmp/${appName}",
    "PACKAGE_FLUTTER_SDK": "cd ${FLUTTER_WORKSPACE}/flutter && tar -czf ${PLATFORM_ID_DIR}/flutter_sdk.tar.gz ./bin/cache/artifacts/engine/linux-x64/icudtl.dat",
    "CREATE_FLUTTER_SDK_DIR": "${SSH_PREFIX} -t root@${DEVICE_HOSTNAME} mkdir -p /custom_flutter_sdk",
    "COPY_FLUTTER_SDK_TO_DEVICE": "${SCP_PREFIX} ${PLATFORM_ID_DIR}/flutter_sdk.tar.gz root@${DEVICE_HOSTNAME}:/custom_flutter_sdk/",
    "COPY_ENGINE_TO_DEVICE": "${SCP_PREFIX} ${FLUTTER_WORKSPACE}/.config/flutter_workspace/flutter-engine/bundle-debug-x64/lib/libflutter_engine.so root@${DEVICE_HOSTNAME}:/usr/lib/libflutter_engine.so",
    "EXTRACT_FLUTTER_SDK": "${SSH_PREFIX} -t root@${DEVICE_HOSTNAME} \"cd /custom_flutter_sdk && tar -xzf flutter_sdk.tar.gz && chmod -R 755 /custom_flutter_sdk\"",
    "SETUP_CUSTOM_FLUTTER_SDK": "${SSH_PREFIX} -t root@${DEVICE_HOSTNAME} \"mkdir -p /custom_flutter_sdk/debug/data && mkdir -p /custom_flutter_sdk/debug/lib && mkdir -p /usr/share/flutter\"",
    "BUILD_FLUTTER_BUNDLE": "flutter build bundle",
    "CREATE_BUNDLE_FOLDERS": "${SSH_PREFIX} -t root@${DEVICE_HOSTNAME} mkdir -p /tmp/${appName}/data/flutter_assets /tmp/${appName}/lib",
    "CREATE_BUNDLE_ICUDTL_SYMLINK": "${SSH_PREFIX} -t root@${DEVICE_HOSTNAME} ln -sf /usr/share/flutter/${FLUTTER_VERSION}/release/data/icudtl.dat /tmp/${appName}/data/icudtl.dat",
    "CREATE_BUNDLE_ENGINE_SYMLINK": "${SSH_PREFIX} -t root@${DEVICE_HOSTNAME} ln -sf /custom_flutter_sdk/debug/lib/libflutter_engine.so /tmp/${appName}/lib/libflutter_engine.so",
    "CREATE_SYSTEM_ICUDTL_SYMLINK": "${SSH_PREFIX} -t root@${DEVICE_HOSTNAME} ln -sf /usr/share/flutter/${FLUTTER_VERSION}/release/data/icudtl.dat /usr/share/flutter/icudtl.dat",
    "CREATE_BUNDLE_FOLDER": "${CREATE_BUNDLE_FOLDERS} && ${CREATE_BUNDLE_ICUDTL_SYMLINK} && ${CREATE_BUNDLE_ENGINE_SYMLINK} && ${CREATE_SYSTEM_ICUDTL_SYMLINK}",
    "COPY_PLATFORM_ID_CONFIG_TO_DEVICE": "${SCP_PREFIX} ${PLATFORM_ID_DIR}/config.toml root@${DEVICE_HOSTNAME}:/tmp/${appName}/",
    "COPY_ASSETS_TO_DEVICE": "${SCP_PREFIX} -r build/flutter_assets/* root@${DEVICE_HOSTNAME}:/tmp/${appName}/data/flutter_assets/",
    "SET_PERMISSIONS": "${SSH_PREFIX} -t root@${DEVICE_HOSTNAME} chmod -R 777 /tmp/${appName} && ${SSH_PREFIX} -t root@${DEVICE_HOSTNAME} chown -R ${COMPOSITOR_USER}:${COMPOSITOR_USER} /tmp/${appName}"
  },
  "runtime": {
    "config": {
      "global": {
        "cursor_theme": "DMZ-White",
        "app_id": "agl-qemu-salmon"
      },
      "view": {
        "window_type": "BG",
        "width": 1080,
        "height": 1920,
        "fullscreen": true
      },
      "window_activation_area": {
        "x": 0,
        "y": 0,
        "width": 1080,
        "height": 1920
      }
    },
    "pre-requisites": {
      "arm64": {
        "darwin": {
          "cmds": [
            "bash -c \"arch -arm64 brew install xz qemu\""
          ]
        }
      },
      "x86_64": {
        "darwin": {
          "cmds": [
            "bash -c \"arch -arm64 brew install xz qemu\""
          ]
        }
      }
    },
    "artifacts": {
      "http": {
        "url": "https://download.automotivelinux.org/AGL/snapshots/${RELEASE_NAME}/${RELEASE_VERSION}",
        "artifacts": {
          "x86_64": [
            {
              "endpoint": "/qemux86-64/deploy/images/qemux86-64/agl-ivi-demo-flutter-qemux86-64.wic.xz"
            }
          ],
          "aarch64": [
            {
              "endpoint": "/qemuarm64/deploy/images/qemuarm64/agl-ivi-demo-flutter-qemuarm64.ext4.xz"
            },
            {
              "endpoint": "/qemuarm64/deploy/images/qemuarm64/Image-qemuarm64.bin"
            }
          ],
          "arm64": [
            {
              "endpoint": "/qemuarm64/deploy/images/qemuarm64/agl-ivi-demo-flutter-qemuarm64.ext4.xz"
            },
            {
              "endpoint": "/qemuarm64/deploy/images/qemuarm64/Image-qemuarm64.bin"
            }
          ]
        }
      }
    },
    "qemu": {
      "cmd": "qemu-system-${FORMAL_MACHINE_ARCH}",
      "x86_64": {
        "image": "agl-ivi-demo-flutter-qemux86-64.wic",
        "args": "-m 2048 ${QEMU_EXTRA} -hda ${QEMU_IMAGE} -cpu kvm64 -cpu qemu64,+ssse3,+sse4.1,+sse4.2,+popcnt -vga virtio -device virtio-rng-pci -serial mon:stdio -serial null -device intel-hda -device hda-duplex -device virtio-net-pci,netdev=net0,mac=${RANDOM_MAC} -netdev user,id=net0,hostfwd=tcp::${CONTAINER_SSH_PORT}-:22,hostfwd=tcp::${FLUTTER_DEBUG_PORT}-:${FLUTTER_DEBUG_PORT}"
      },
      "arm64": {
        "kernel": "artifacts/Image-qemuarm64.bin",
        "image": "agl-ivi-demo-flutter-qemuarm64.ext4",
        "args": "-accel hvf -cpu host -M virt ${QEMU_EXTRA} -m 4096 -device virtio-gpu-pci -nographic -display cocoa,show-cursor=on -object rng-random,filename=/dev/urandom,id=rng0 -device virtio-rng-pci,rng=rng0 -device qemu-xhci -device usb-tablet -device usb-mouse -device usb-kbd -device virtio-net-pci,netdev=vnet -netdev user,id=vnet,hostfwd=tcp::${CONTAINER_SSH_PORT}-:22,hostfwd=tcp::${FLUTTER_DEBUG_PORT}-:${FLUTTER_DEBUG_PORT} -kernel ${QEMU_KERNEL} -drive file=${QEMU_IMAGE},format=raw,if=virtio -append root=/dev/vda"
      },
      "extra": {
        "darwin": "-smp cpus=8,sockets=1,cores=8,threads=1",
        "ubuntu": "-bios OVMF.fd",
        "fedora": "-bios /usr/share/edk2/ovmf/OVMF_CODE.fd"
      }
    },
    "post_cmds": [
      {
        "cwd": "${PLATFORM_ID_DIR}",
        "cmds": [
          "bash -c \"rm ${QEMU_IMAGE}|true\"",
          "unxz --keep ${QEMU_IMAGE}.xz"
        ]
      }
    ]
  },
  "overwrite-existing": true,
  "custom-device": {
    "id": "agl-qemu-${RELEASE_NAME}",
    "label": "AGL ${RELEASE_NAME}-${RELEASE_VERSION} QEMU Image",
    "sdkNameAndVersion": "qemu-${RELEASE_NAME} ${RELEASE_VERSION}",
    "platform": "linux-x64",
    "enabled": true,
    "ping": "bash -c \"${PING_CMD}\"",
    "pingSuccessRegex": "open",
    "postBuild": "bash -c \"${STOP_SERVICE} && ${DELETE_USER_PWD} && ${PACKAGE_FLUTTER_SDK} && ${CREATE_FLUTTER_SDK_DIR} && ${COPY_FLUTTER_SDK_TO_DEVICE} && ${COPY_ENGINE_TO_DEVICE} && ${EXTRACT_FLUTTER_SDK} && ${SETUP_CUSTOM_FLUTTER_SDK}\"",
    "install": "bash -c \"${BUILD_FLUTTER_BUNDLE} && ${CREATE_BUNDLE_FOLDER} && ${COPY_PLATFORM_ID_CONFIG_TO_DEVICE} && ${COPY_ASSETS_TO_DEVICE} && ${SET_PERMISSIONS}\"",
    "uninstall": "bash -c \"${DELETE_APP_FOLDER}\"",
    "runDebug": "bash -c \"${SSH_PREFIX} ${COMPOSITOR_USER}@${DEVICE_HOSTNAME} ${FLUTTER_AUTO_EXE}\"",
    "forwardPort": null,
    "forwardPortSuccessRegex": null,
    "screenshot": null
  }
}

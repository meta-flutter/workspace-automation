{
    "id": "libcamera",
    "load": false,
    "supported_archs": [
        "aarch64",
        "arm64",
        "x86_64"
    ],
    "supported_host_types": [
        "ubuntu",
        "fedora"
    ],
    "type": "dependency",
    "env": {
        "PATH": "${PATH}:${FLUTTER_WORKSPACE}/app/depot_tools",
        "CAMERA_SRC_DIR": "${FLUTTER_WORKSPACE}/app/libcamera",
        "CAMERA_BUILD_DIR": "${FLUTTER_WORKSPACE}/app/libcamera/buildDir",
        "INSTALL_PREFIX": "${FLUTTER_WORKSPACE}/app/libcamera/out/usr",
        "CAMERA_MESON_ARGS": "--prefix=${INSTALL_PREFIX} -Dqcam=\"disabled\" -Dlc-compliance=\"disabled\" -Dcam=\"disabled\" -Dgstreamer=\"disabled\""
    },
    "src": [
        {
            "uri": "https://git.libcamera.org/libcamera/libcamera.git",
            "branch": "master",
            "rev": "v0.4.0"
        }
    ],
    "runtime": {
        "pre-requisites": {
            "aarch64": {
                "ubuntu": {
                    "cmds": [
                        "sudo apt install -y libjpeg-dev libevent-dev",
                        "pip3 install jinja2 ply pyyaml meson"
                    ]
                }
            },
            "x86_64": {
                "ubuntu": {
                    "cmds": [
                        "sudo apt install -y libjpeg-dev libevent-dev",
                        "pip3 install jinja2 ply pyyaml meson"
                    ]
                },
                "fedora": {
                    "cmds": [
                        "sudo dnf install -y libjpeg-devel libevent-devel",
                        "pip3 install jinja2 ply pyyaml meson"
                    ]
                }
            }
        },
        "post_cmds": [
            {
                "cwd": "${CAMERA_SRC_DIR}",
                "cmds": [
                    "bash -c \"sudo rm -rf ${CAMERA_BUILD_DIR}/* | true\"",
                    "meson setup buildDir ${CAMERA_MESON_ARGS}"
                ]
            },
            {
                "cwd": "${CAMERA_BUILD_DIR}",
                "cmds": [
                    "autoninja -C ${CAMERA_BUILD_DIR} install"
                ]
            }
        ]
    }
}